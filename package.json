{
  "name": "chronicle-changelog",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev",
    "build": "prisma generate && prisma db push --accept-data-loss && tsx prisma/seed.ts && cp prisma/dev.db prisma/starter.db && cp prisma/dev.db public/starter.db && node -e \"const fs=require('fs'); fs.writeFileSync('server/utils/starter-db-data.ts', 'export const STARTER_DB_BASE64 = \\x22' + fs.readFileSync('prisma/starter.db').toString('base64') + '\\x22;\\n')\" && nuxt build",
    "test": "tsx tests/verify-all.ts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:push": "prisma db push --accept-data-loss"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@vueuse/core": "^12.2.0",
    "@vueuse/motion": "^2.2.6",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.3",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.1.0",
    "nuxt": "^3.14.159",
    "radix-vue": "^1.9.15",
    "tailwind-merge": "^2.6.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@nuxtjs/tailwindcss": "^6.13.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
